  "components": {
    "schemas": {
      "AdminStats": {
        "properties": {
          "scheduled_future_flights": {
            "type": "integer",
            "title": "Scheduled Future Flights"
          },
          "confirmed_bookings": {
            "type": "integer",
            "title": "Confirmed Bookings"
          },
          "seats_sold": {
            "type": "integer",
            "title": "Seats Sold"
          },
          "seats_available": {
            "type": "integer",
            "title": "Seats Available"
          },
          "load_factor": {
            "type": "number",
            "title": "Load Factor"
          }
        },
        "type": "object",
        "required": [
          "scheduled_future_flights",
          "confirmed_bookings",
          "seats_sold",
          "seats_available",
          "load_factor"
        ],
        "title": "AdminStats"
      },
      "AirportPublic": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "city": {
            "type": "string",
            "title": "City"
          },
          "country": {
            "type": "string",
            "title": "Country"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          }
        },
        "type": "object",
        "required": ["id", "code", "city", "country", "name", "timezone"],
        "title": "AirportPublic"
      },
      "AirportsPublic": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/AirportPublic"
            },
            "type": "array",
            "title": "Data"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": ["data", "count"],
        "title": "AirportsPublic"
      },
      "Body_login-login_access_token": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^password$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": ["username", "password"],
        "title": "Body_login-login_access_token"
      },
      "BookingCreate": {
        "properties": {
          "flight_id": {
            "type": "string",
            "format": "uuid",
            "title": "Flight Id"
          },
          "passenger_name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Passenger Name"
          },
          "passenger_email": {
            "type": "string",
            "maxLength": 255,
            "format": "email",
            "title": "Passenger Email"
          }
        },
        "type": "object",
        "required": ["flight_id", "passenger_name", "passenger_email"],
        "title": "BookingCreate"
      },
      "BookingLookup": {
        "properties": {
          "booking_reference": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Booking Reference"
          },
          "passenger_email": {
            "type": "string",
            "maxLength": 255,
            "format": "email",
            "title": "Passenger Email"
          }
