# Copy to .env for Docker Compose. Never commit real values.
ENVIRONMENT=production
PROJECT_NAME=Tahr Air
FRONTEND_HOST=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:8000

SECRET_KEY=changethis
FIRST_SUPERUSER=wardenn-admin@tahr.ca
FIRST_SUPERUSER_PASSWORD=changethis

POSTGRES_DB=tahr_air
POSTGRES_USER=tahr_air
POSTGRES_PASSWORD=changethis

# Local builds use this tag. Production operators must replace it with an
# exact ghcr.io/tahr-security/tahr-airline@sha256:... reference.
TAHR_AIR_IMAGE=tahr-airline:local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
